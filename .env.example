# Copy this file to .env and fill in the values

# Port the Express server listens on locally. Render sets its own PORT env
# var automatically in production — this is only used for local dev.
PORT="4000"

# The deployed Netlify frontend URL(s), comma-separated if you have more than
# one (e.g. prod + deploy previews). Required for CORS + cross-site cookies
# to work. Example: "https://your-site.netlify.app,http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Postgres in production (Render's free Postgres plugs straight into this).
# For local dev without installing Postgres, you can point this at a local
# SQLite file instead — but then flip `provider` in prisma/schema.prisma from
# "postgresql" to "sqlite" to match.
DATABASE_URL="postgresql://user:password@localhost:5432/atelier"

# --- Chat providers, tried in this order, all free-tier / free ---
#
#     Groq #1 -> Groq #2 -> NVIDIA #1 -> NVIDIA #2 -> Cerebras -> Ollama
#
# Each hosted slot has its own circuit breaker: if it gets rate-limited or
# starts timing out, it's skipped for a cooldown window instead of paying
# its timeout on every request. You don't need all of these — even zero of
# them "configured" still works as long as Ollama is running locally.

# 1) Groq — free tier, fast, real hosted concurrency. Get a key (no card needed
#    to start) at https://console.groq.com/keys. Leave blank to skip.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Optional second Groq key — ideally from a SEPARATE account/signup, since
# free-tier limits are usually enforced per account, not per key. Leave
# blank to just use one Groq key.
GROQ_API_KEY_2=""
# How long (seconds) to wait for Groq's first token before giving up on it.
GROQ_TIMEOUT_SECONDS="8"

# 2) NVIDIA NIM — free tier, hosted. Get a key at https://build.nvidia.com/.
#    Leave blank to skip.
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
# Optional second NVIDIA key — same idea as GROQ_API_KEY_2 above.
NVIDIA_API_KEY_2=""
NVIDIA_TIMEOUT_SECONDS="8"

# 3) Cerebras — free tier, no credit card, 1M tokens/day. Get a key at
#    https://cloud.cerebras.ai. Leave blank to skip. If CEREBRAS_MODEL 404s,
#    check https://inference-docs.cerebras.ai for their current free models.
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama-3.3-70b"
CEREBRAS_TIMEOUT_SECONDS="8"

# 4) Ollama — local, free, unlimited, but only as fast/available as this
#    machine. Install from https://ollama.com, then `ollama pull llama3.1`.
#    Used automatically if none of the hosted providers above are
#    configured or all of them fail. Won't be reachable once deployed to
#    Render unless Ollama also runs on that same machine.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_TIMEOUT_SECONDS="30"

# --- Circuit breaker tuning (optional — sane defaults if left unset) ---
# GROQ_COOLDOWN_SECONDS="60"
# GROQ_TIMEOUT_TRIP_THRESHOLD="2"
# GROQ_TIMEOUT_COOLDOWN_SECONDS="20"

# Optional and NOT free — only needed if you want the "Generate with AI" avatar
# button to work. Without it, avatar upload still works fine, for $0.
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=""

# Any long random string, used to sign login sessions
SESSION_SECRET="change-this-to-a-long-random-string"
