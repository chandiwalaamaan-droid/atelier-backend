# Local setup only. Preserve your existing hosted environment variables.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
PORT=4000
DISABLE_RETENTION_CRON=true
# Configure at least one supported chat provider. Example:
NVIDIA_API_KEY=
# Keep your existing media, email, and optional provider settings.

# Hazelnut: compact context is enabled by default. These are optional.
# Soft input target estimated locally; long current turns and persona are preserved.
HAZELNUT_INPUT_TARGET_TOKENS=2800
# Set false to restore the previous Hazelnut prompt/history behavior.
HAZELNUT_COMPACT_CONTEXT=true
