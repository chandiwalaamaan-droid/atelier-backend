# Backend API URL (required)
# Set this to your deployed Render backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://rolichat-backend.onrender.com
NEXT_PUBLIC_API_URL=

# Google OAuth Client ID (optional)
# Leave unset to hide the Google sign-in button.
# Must match the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay Key ID (optional)
# Only needed once billing goes live. Leave unset for now.
NEXT_PUBLIC_RAZORPAY_KEY_ID=