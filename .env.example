# CockroachDB Serverless connection string (free at cockroachlabs.cloud, 10 GiB
# free storage). Any Postgres-wire-compatible string works since
# prisma/schema.prisma uses the "cockroachdb" provider.
DATABASE_URL="postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full"

# Frontend origin(s) allowed by CORS, comma-separated. http://localhost:3000
# for local dev; your Netlify URL(s) in production.
FRONTEND_URL="http://localhost:3000"

# Any long random string — signs session JWTs.
SESSION_SECRET=""

# Optional SMTP settings for password-reset / email-verification /
# inactivity-warning emails. If left unset, those emails are printed to the
# server console instead of sent, so auth flows still work in local dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Atelier <no-reply@atelier.local>"

# Comma-separated list of account emails allowed to hit /api/admin/reports*.
# Leave unset to disable admin access entirely.
ADMIN_EMAILS=""

# Avatar hosting (uploaded + AI-generated character avatars). Free account at
# cloudinary.com — get these three from the dashboard home page after signup.
# No persistent disk needed; images survive restarts/redeploys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Avatar image generation — Pollinations (keyless, always on, unfiltered for
# explicit personas) is tried first. Hugging Face is the fallback when
# HUGGINGFACE_API_KEY is set and Pollinations fails/times out; free token
# from huggingface.co -> Settings -> Access Tokens. See src/routes/avatar.ts.
HUGGINGFACE_API_KEY=""
HUGGINGFACE_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# Chat providers — set at least one, or run Ollama locally.
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_MODEL="qwen/qwen3.6-27b"
NVIDIA_API_KEY=""
NVIDIA_API_KEY_2=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
CEREBRAS_API_KEY=""
CEREBRAS_API_KEY_2=""
CEREBRAS_MODEL="llama-3.3-70b"
SAMBANOVA_API_KEY=""
SAMBANOVA_API_KEY_2=""
SAMBANOVA_MODEL="Meta-Llama-3.3-70B-Instruct"

# Razorpay billing scaffold — everything in src/routes/billing.ts 503s unless
# PAYMENTS_ENABLED is exactly "true". Leave "false" until ready to take
# payments; see src/lib/payments/razorpay.ts.
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Set to "true" to disable the daily inactive-account cleanup cron while
# developing locally. See src/jobs/retentionCleanup.ts.
DISABLE_RETENTION_CRON="false"
