# CockroachDB Serverless connection string (free at cockroachlabs.cloud, 10 GiB
# free storage). Any Postgres-wire-compatible string works since
# prisma/schema.prisma uses the "cockroachdb" provider.
#
# Connection pooling: Prisma includes its own built-in pooler for Postgres/
# CockroachDB backends (pg-bouncer style). No external pooler is needed for
# the free tier — just make sure the DATABASE_URL has no conflicting pool
# settings in it. If using a self-hosted Postgres alongside a separate pgbouncer,
# append ?pgbouncer=true to the connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full"

# Frontend origin(s) allowed by CORS, comma-separated. Include your Netlify
# URL(s) AND any mobile-specific origin (e.g. a separate mobile deploy, or
# the same Netlify URL if that's what the mobile web client uses).
FRONTEND_URL="http://localhost:3000"

# "Sign in with Google" — OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console > APIs & Services > Credentials. No client secret
# needed here — this only verifies ID tokens.
GOOGLE_CLIENT_ID=""

# Any long random string — signs session JWTs.
SESSION_SECRET=""

# Optional SMTP settings for password-reset / email-verification /
# inactivity-warning emails. If left unset, those emails are printed to the
# server console instead of sent, so auth flows still work in local dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rolichat <no-reply@rolichat.local>"

# Comma-separated list of account emails allowed to hit /api/admin/reports*.
# Leave unset to disable admin access entirely.
ADMIN_EMAILS=""

# Avatar hosting (uploaded + AI-generated character avatars). Free account at
# backblaze.com/b2 (10GB free) — key id/app key from the Application Keys
# page, bucket name/endpoint from the bucket's own page. No persistent disk
# needed; images survive restarts/redeploys. Bucket can stay PRIVATE — the
# backend proxies/streams images itself via /api/images/:key, so no
# card-on-file is needed for B2's first-public-bucket verification.
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_ENDPOINT=""

# Redis for BullMQ image generation queue.
# Use a managed Redis (e.g. Upstash, Redis Cloud) in production.
REDIS_URL="redis://127.0.0.1:6379"

# Image generation queue worker concurrency.
IMAGE_GEN_WORKER_CONCURRENCY="4"

# Avatar/scene image generation — tried in this order, see src/routes/avatar.ts:
# 1. Pollinations (keyless, always on, unfiltered for explicit personas).
#    POLLINATIONS_API_KEY is optional (higher rate limits if set).
# 2. Cloudflare Workers AI — separate account/token from the
#    CLOUDFLARE_CHAT_* vars below, which are only for chat.
#    See src/lib/providers/cloudflare.ts.
POLLINATIONS_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_IMAGE_MODEL="@cf/lykon/dreamshaper-8-lcm"

# Chat providers — set at least one, or run Ollama locally.
# Groq is first in the chain for diagnosis using qwen/qwen3.6-27b
# (its Llama models were deprecated by Groq). GROQ_API_KEY is also still
# needed if you want voice playback (TTS) via Groq's Orpheus model.
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_MODEL="qwen/qwen3.6-27b"
NVIDIA_API_KEY=""
NVIDIA_API_KEY_2=""
NVIDIA_API_KEY_3=""
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
SAMBANOVA_API_KEY=""
SAMBANOVA_API_KEY_2=""
SAMBANOVA_MODEL="Meta-Llama-3.3-70B-Instruct"

# Cloudflare Workers AI (Llama 4 Scout) as a chat provider — separate
# account/token from CLOUDFLARE_ACCOUNT_ID/CLOUDFLARE_API_TOKEN above,
# which is only for avatar image generation. Wired after NVIDIA in the
# fallback chain (see providers/index.ts) since it's slower than the other
# hosted providers, but confirmed working in production.
CLOUDFLARE_CHAT_ACCOUNT_ID=""
CLOUDFLARE_CHAT_API_TOKEN=""
CLOUDFLARE_CHAT_MODEL="@cf/meta/llama-4-scout-17b-16e-instruct"

# Razorpay billing scaffold — everything in src/routes/billing.ts 503s unless
# PAYMENTS_ENABLED is exactly "true". Leave "false" until ready to take
# payments; see src/lib/payments/razorpay.ts.
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Set to "true" to disable the daily inactive-account cleanup cron while
# developing locally. See src/jobs/retentionCleanup.ts.
DISABLE_RETENTION_CRON="false"

# ──────────────────────────────────────────────────────────────────────────────
# Recommended free-tier setup for 100–200 daily active users (~20k–40k messages/day)
#
# Cost: $0/month for all services listed below.
#
# Chat providers (set at least one, or run Ollama locally):
#   SAMBANOVA_API_KEY      — SambaNova free tier. Get one free key at
#                            cloud.sambanova.ai (no credit card, persists
#                            indefinitely). Fastest provider, kept first in
#                            the chain despite 20 req/day limit.
#   NVIDIA_API_KEY         — NVIDIA NIM free tier. Get one free key at
#                            build.nvidia.com (no credit card needed).
#
# Fallback order: Groq -> SambaNova -> NVIDIA -> Cloudflare -> Ollama
#
# Note: Groq was temporarily removed because its Llama models were
# deprecated, but it's back for diagnosis using qwen/qwen3.6-27b.
# Cerebras was removed because its free tier requires adding a payment
# method.
#
# Throughput vs. quality (src/lib/providers/index.ts):
#   RECENT_MESSAGE_WINDOW / SUMMARIZE_TRIGGER — how much raw history goes into
#   every request. Higher = better short-term memory & consistency, but more
#   tokens burned per message (fewer messages/day on a fixed free-tier budget).
#   Current defaults (8 / 15) are a middle ground; push both down if you're
#   hitting daily limits, push up if replies feel forgetful.
#   max_tokens is capped at 130 (~100 words) for all providers to keep replies
#   short and save tokens. Adjust in src/lib/providers/openaiCompatible.ts if
#   you want longer or shorter replies.
#   CLOUDFLARE_CHAT_*      — Cloudflare Workers AI (10,000 Neurons/day per
#                            account). Used as a last-resort fallback since the
#                            Neurons budget is a hard daily ceiling. Create a
#                            second Cloudflare account for a second Neurons pool.
#
# Infrastructure:
#   DATABASE_URL           — CockroachDB Serverless (10 GiB free)
#                            cockroachlabs.cloud
#   B2_*                   — Backblaze B2 (10 GB free) for avatar/scene images
#                            backblaze.com/b2
#   FRONTEND_URL           — Your Netlify frontend URL (comma-separated for
#                            multiple environments)
#
# Optional (not required for free tier):
#   SMTP_*                 — Only needed for email features; flows degrade
#                            gracefully without them (emails logged to console)
#   RAZORPAY_*             — Billing scaffold (inert until PAYMENTS_ENABLED=true)
# ──────────────────────────────────────────────────────────────────────────────
